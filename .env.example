# PostgreSQL + pgvector connection used by the FastAPI application and Alembic.
DATABASE_URL=postgresql+psycopg://research:research@localhost:55432/research_lab

# Server-only API origin used by Next.js Server Components and Server Actions.
# Production keeps this on loopback; there is intentionally no public API hostname.
INTERNAL_API_BASE_URL=http://localhost:8000

# Workspace behavior. Development defaults to a writable personal workspace.
# Set both flags in the public portfolio deployment so the UI and API are read-only.
NEXT_PUBLIC_WORKSPACE_MODE=personal
READ_ONLY_MODE=false
APP_ENVIRONMENT=development
# Optional defense-in-depth allowlist for an intentionally exposed API hostname.
# Leave blank for the current internal-only API architecture.
PUBLIC_API_HOSTS=

# OpenAlex currently gives no-key calls a $0.10/day budget; a free key raises it to $1/day.
# Create one from https://openalex.org/settings/api when you want larger refreshes.
OPENALEX_API_KEY=

# Unpaywall v2 requires a contact email, not an API key. If omitted, CROSSREF_MAILTO is reused.
# https://data.unpaywall.org/products/api
UNPAYWALL_EMAIL=

# Optional CORE API v3 Bearer key. Register at https://core.ac.uk/services/api.
CORE_API_KEY=

# Optional asynchronous Korean title/abstract translation. DeepL API Free resets
# by account billing period; the worker checks /v2/usage before every batch.
# https://developers.deepl.com/docs/getting-started/auth
DEEPL_API_KEY=
TRANSLATION_MONTHLY_RESERVE_CHARACTERS=10000

# Identifies this project to Crossref's polite pool. Use your own contact email locally.
CROSSREF_MAILTO=

# Optional. Semantic Scholar enrichment is disabled unless a key is present and its API terms are accepted.
SEMANTIC_SCHOLAR_API_KEY=

# Reserved for a future external LLM adapter. The current MVP does not require or call OpenAI.
OPENAI_API_KEY=

# Optional local semantic embeddings. `local_hash` remains the zero-download engineering baseline.
# Install the API `local-embeddings` extra before selecting `fastembed`.
EMBEDDING_PROVIDER=local_hash
FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
FASTEMBED_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Private, local-only storage for user-supplied PDFs. This directory is Git-ignored.
PRIVATE_DATA_ROOT=../../data/private
PRIVATE_DATA_REQUIRE_EXTERNAL=false
PRIVATE_DATA_EXPECTED_MOUNT=
PRIVATE_DATA_SENTINEL=
PRIVATE_DATA_MIN_FREE_GB=25
